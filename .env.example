# Copy to .env.local. Every provider defaults to its mock, so the app runs with no keys.
# Synthetic data only: never put real patient data in this app.

# --- Provider selection -------------------------------------------------------
# mock | gemini
VISION_PROVIDER=mock
# mock | gemini
PROTOCOL_COMPILER=mock
# memory | supabase
PERSISTENCE=memory
# mock (a real SMS/telephony provider is stubbed in src/escalation)
NOTIFIER=mock
# browser | gemini-live
NEXT_PUBLIC_VOICE_PROVIDER=browser

# --- Gemini (https://aistudio.google.com/apikey) ------------------------------
GEMINI_API_KEY=
GEMINI_COMPILER_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live

# --- Supabase (server only; the browser never gets a Supabase key) ------------
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- App ----------------------------------------------------------------------
# Hackathon gate for the coordinator dashboard (real auth is on the roadmap).
COORDINATOR_PASSCODE=
# The trial's 24/7 nurse line. 555-01xx numbers are fictional.
NEXT_PUBLIC_TRIAL_NURSE_PHONE=+1-555-0100
